    {
      "do": "say",
      "line": "brief_heins_01"
    },
    {
      "do": "say",
      "line": "brief_heins_02"
    },
    {
      "do": "say",
      "line": "brief_sung_01"
    },
    {
      "do": "say",
      "line": "brief_heins_03"
    },
    {
      "do": "playerFrame",
