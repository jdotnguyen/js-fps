[
 {
  "id": "quiet_restore",
  "trigger": {
   "event": "game:mode",
   "match": {
    "mode": "playing",
    "from": "title"
   }
  },
  "steps": [
   {
    "do": "if",
    "flag": "radio_place",
    "is": "hydro",
    "then": [
     {
      "do": "setFlag",
      "flag": "radio_place",
      "value": "none"
     }
    ]
   },
   {
    "do": "if",
    "flag": "radio_place",
    "is": "dive",
    "then": [
     {
      "do": "setFlag",
      "flag": "radio_place",
      "value": "none"
     }
    ]
   },
   {
    "do": "if",
    "flag": "radio_place",
    "is": "ruined",
    "then": [
     {
      "do": "setFlag",
      "flag": "radio_place",
      "value": "none"
     }
    ]
   },
   {
    "do": "if",
    "flag": "radio_muted",
    "then": [],
    "else": [
     {
      "do": "if",
      "flag": "radio_place",
      "is": "commons",
      "then": [
       {
        "do": "radio",
        "track": "tag_fm_01",
        "at": "anchor:radio"
       }
      ]
     }
    ]
   },
   {
    "do": "if",
    "flag": "introSeen",
    "then": [
     {
      "do": "npcTask",
      "npc": "dock_guard",
      "task": "return_to_desk",
      "instant": true
     },
     {
      "do": "if",
      "flag": "priya_met",
      "then": [
       {
        "do": "if",
        "flag": "sec_done",
        "then": [],
        "else": [
         {
          "do": "npcMoveTo",
          "npc": "priya",
          "to": "anchor:priya_offstage",
          "instant": true
         },
         {
          "do": "npcAnim",
          "npc": "priya",
          "anim": "idle",
          "instant": true
         }
        ]
       }
      ]
     }
    ]
   },
   {
    "do": "if",
    "flag": "commons_changed_1",
    "then": [
     {
      "do": "emit",
      "event": "screen:set",
      "payload": {
       "id": "commons_tv",
       "state": "on"
      }
     },
     {
      "do": "npcMoveTo",
      "npc": "cook",
      "to": "anchor:cook_stand",
      "instant": true
     },
     {
      "do": "npcAnim",
      "npc": "cook",
      "anim": "idle",
      "instant": true
     }
    ]
   },
   {
    "do": "if",
    "flag": "rounds_done",
    "then": [
     {
      "do": "emit",
      "event": "blinds:set",
      "payload": {
       "id": "labb",
       "state": "up",
       "instant": true
      }
     },
     {
      "do": "if",
      "flag": "drop_started",
      "is": false,
      "then": [
       {
        "do": "emit",
        "event": "drop:approach"
       }
      ]
     }
    ]
   },
   {
    "do": "if",
    "flag": "drop_done",
    "then": [
     {
      "do": "kill",
      "npc": "researcher_b",
      "kind": "grownInside",
      "glass": "anchor:labb_glass",
      "instant": true
     },
     {
      "do": "despawn",
      "npc": "researcher_b_creature"
     },
     {
      "do": "ventState",
      "id": "labb_vent",
      "state": "open",
      "instant": true
     },
     {
      "do": "lightState",
      "room": "R04",
      "pattern": "alarm",
      "tint": "emergency"
     },
     {
      "do": "lightState",
      "room": "R03",
      "pattern": "steady",
      "tint": "emergency"
     }
    ]
   },
   {
    "do": "if",
    "flag": "dive_trunk_secured",
    "then": [
     {
      "do": "emit",
      "event": "trunk:state",
      "payload": {
       "state": "closed",
       "instant": true
      }
     }
    ]
   }
  ]
 }
]
