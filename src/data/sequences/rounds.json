   },
   {
    "do": "emit",
    "event": "rounds:progress",
    "payload": {
     "which": "hydro"
    }
   },
   {
    "do": "if",
    "flag": "round_dive_done",
    "then": [
     {
      "do": "if",
      "flag": "round_admin_done",
      "then": [
       {
        "do": "emit",
        "event": "rounds:all_done"
       }
      ]
     }
    ]
   }
  ]
 },
