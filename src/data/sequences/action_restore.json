[
 {
  "id": "action_restore",
  "trigger": {
   "event": "game:mode",
   "match": {
    "mode": "playing",
    "from": "title"
   }
  },
  "steps": [
   {
    "do": "if",
    "flag": "station_power",
    "is": "backup",
    "then": [
     {
      "do": "power",
      "state": "backup"
     }
    ],
    "else": [
     {
      "do": "if",
      "flag": "contact_done",
      "then": [
       {
        "do": "power",
        "state": "backup"
       }
      ]
     }
    ]
   },
   {
    "do": "if",
    "flag": "drop_started",
    "then": [
     {
      "do": "doorState",
      "id": "D_R02_R03",
      "state": "sealed"
     }
    ]
   },
   {
    "do": "if",
    "flag": "drop_done",
    "then": [
     {
      "do": "doorState",
      "id": "D_R03_R05",
      "state": "closed"
     },
     {
      "do": "emit",
      "event": "bloom:spread"
     }
    ]
   },
   {
    "do": "if",
    "flag": "contact_done",
    "then": [
     {
      "do": "doorState",
      "id": "D_R05_R06",
      "state": "closed"
     }
    ]
   },
   {
    "do": "if",
    "flag": "cover_done",
    "then": [
     {
      "do": "doorState",
      "id": "D_R06_R07",
      "state": "open"
     },
     {
      "do": "ventState",
      "id": "r06_vent",
      "state": "fallen",
      "instant": true
     }
    ]
   },
   {
    "do": "if",
    "flag": "armory_open",
    "then": [
     {
      "do": "doorState",
      "id": "D_R07_R07a",
      "state": "open"
     }
    ]
   },
   {
    "do": "if",
    "flag": "medlab_open",
    "then": [
     {
      "do": "doorState",
      "id": "D_R07_R09",
      "state": "open"
     }
    ]
   },
   {
    "do": "if",
    "flag": "valve_done",
    "then": [
     {
      "do": "doorState",
      "id": "D_R10_R11",
      "state": "closed"
     }
    ]
   },
   {
    "do": "if",
    "flag": "r11_powered",
    "then": [
     {
      "do": "light",
      "id": "r11_bank_1a",
      "pattern": "steady",
      "power": 1
     },
     {
      "do": "light",
      "id": "r11_bank_1b",
      "pattern": "steady",
      "power": 1
     },
     {
      "do": "light",
      "id": "r11_bank_2a",
      "pattern": "steady",
      "power": 1
     },
     {
      "do": "light",
      "id": "r11_bank_2b",
      "pattern": "steady",
      "power": 1
     },
     {
      "do": "light",
      "id": "r11_bank_3a",
      "pattern": "steady",
      "power": 1
     },
     {
      "do": "light",
      "id": "r11_bank_3b",
      "pattern": "steady",
      "power": 1
     },
     {
      "do": "light",
      "id": "r11_beacon_ne",
      "pattern": "off",
      "power": 0
     },
     {
      "do": "light",
      "id": "r11_beacon_sw",
      "pattern": "off",
      "power": 0
     },
     {
      "do": "emit",
      "event": "r11:power_state",
      "payload": {
       "state": "online",
       "instant": true
      }
     },
     {
      "do": "emit",
      "event": "r11:hum_on"
     },
     {
      "do": "doorState",
      "id": "D_R13d_R11",
      "state": "open"
     },
     {
      "do": "doorState",
      "id": "D_R13d_R15a",
      "state": "closed"
     }
    ]
   },
   {
    "do": "if",
    "flag": "transit_ride_done",
    "then": [
     {
      "do": "emit",
      "event": "transit:blast_gate",
      "payload": {
       "gateId": "r16a_north",
       "open": false
      }
     },
     {
      "do": "emit",
      "event": "transit:train_door",
      "payload": {
       "carId": "r16a_train",
       "open": false,
       "instant": true
      }
     },
     {
      "do": "emit",
      "event": "transit:comms_state",
      "payload": {
       "state": "lost"
      }
     },
     {
      "do": "emit",
      "event": "transit:tunnel_power",
      "payload": {
       "mode": "emergency"
      }
     },
     {
      "do": "if",
      "flag": "r16_finale_done",
      "then": [
       {
        "do": "emit",
        "event": "squad:flashlight",
        "payload": {
         "ids": "giles,okafor",
         "on": false
        }
       },
       {
        "do": "emit",
        "event": "transit:train_aux_lights",
        "payload": {
         "carId": "r16a_train",
         "on": false
        }
       }
      ]
     }
    ]
   },
   {
    "do": "if",
    "flag": "cover_done",
    "then": [
     {
      "do": "intercom",
      "id": "medbay",
      "state": "off"
     },
     {
      "do": "doorState",
      "id": "D_R07_R08",
      "state": "sealed"
     },
     {
      "do": "if",
      "flag": "sec_done",
      "then": [
       {
        "do": "npcMoveTo",
        "npc": "priya",
        "to": "anchor:priya_rest",
        "instant": true
       },
       {
        "do": "kill",
        "npc": "priya",
        "kind": "mauled",
        "glass": "anchor:medbay_c_glass",
        "marks": {
         "along": "anchor:r08_along",
          "lane": "anchor:r08_lane",
          "lane2": "anchor:r08_lane2",
         "cower": "anchor:priya_cower",
         "impale": "anchor:r08_impale",
         "around": "anchor:r08_around",
         "slamSpot": "anchor:r08_slam_spot",
         "slamFace": "anchor:r08_slam_face",
         "cart": "anchor:r08_cart_top",
         "throwAt": "anchor:r08_throw_point",
         "rest": "anchor:priya_rest",
         "exit": "anchor:r08_along",
         "surgery": "anchor:r08_lurk",
         "surgeryIn": "anchor:r08_surgery_in",
         "surgeryOut": "anchor:r08_surgery_out",
         "glassLook": "anchor:medbay_c_glass"
        },
        "instant": true
       },
       {
        "do": "npcMoveTo",
        "npc": "priya",
        "to": "anchor:priya_rest",
        "instant": true
       },
       {
        "do": "npcAnim",
        "npc": "priya",
        "anim": "corpseSlumped",
        "instant": true
       },
       {
        "do": "gore",
        "at": "anchor:priya_rest",
        "kind": "pool",
        "size": 1.0
       },
       {
        "do": "gore",
        "at": "anchor:priya_rest",
        "kind": "pool",
        "size": 1.4
       },
       {
        "do": "gore",
        "at": "anchor:priya_rest",
        "kind": "pool",
        "size": 1.8
       },
       {
        "do": "gore",
        "at": "anchor:r08_impale",
        "kind": "pool",
        "size": 0.8
       },
       {
        "do": "gore",
        "at": "anchor:r08_slam_spot",
        "kind": "pool",
        "size": 0.5
       }
      ],
      "else": [
       {
        "do": "npcMoveTo",
        "npc": "priya",
        "to": "anchor:priya_r07_hide",
        "instant": true
       },
       {
        "do": "npcAnim",
        "npc": "priya",
        "anim": "priya_crouch",
        "instant": true
       }
      ]
     }
    ]
   }
  ]
 },
 {
  "id": "r16_restore",
  "trigger": {
   "event": "game:mode",
   "match": {
    "mode": "playing",
    "from": "title"
   },
   "requires": "transit_ride_done",
   "unless": "r16_finale_done"
  },
  "steps": [
   {
    "do": "wait",
    "s": 0.1
   },
   {
    "do": "emit",
    "event": "transit:blast_gate",
    "payload": {
     "gateId": "r16a_north",
     "open": false
    }
   },
   {
    "do": "emit",
    "event": "transit:train_door",
    "payload": {
     "carId": "r16a_train",
     "open": false,
     "instant": true
    }
   },
   {
    "do": "lightState",
    "room": "R16a",
    "pattern": "off",
    "tint": "black"
   },
   {
    "do": "lightState",
    "room": "R16b",
    "pattern": "off",
    "tint": "black"
   },
   {
    "do": "emit",
    "event": "transit:r16_beacons",
    "payload": {
     "on": false
    }
   },
   {
    "do": "light",
    "id": "r16a_train_cabin_a",
    "pattern": "steady",
    "tint": "#ffb974",
    "power": 1
   },
   {
    "do": "light",
    "id": "r16a_train_cabin_b",
    "pattern": "steady",
    "tint": "#ffb974",
    "power": 1
   },
   {
    "do": "npcMoveTo",
    "npc": "giles",
    "to": "anchor:r16_cabin_giles",
    "instant": true
   },
   {
    "do": "npcMoveTo",
    "npc": "okafor",
    "to": "anchor:r16_cabin_okafor",
    "instant": true
   },
   {
    "do": "setFlag",
    "flag": "seq:r16_arrival_finale",
    "value": false
   },
   {
    "do": "emit",
    "event": "transit:arrived_r16"
   }
  ]
 }
]
