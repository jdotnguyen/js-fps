[
 {
  "id": "climax",
  "trigger": {
   "event": "trigger:r11_enter",
   "requires": "valve_done",
   "unless": "climax_done"
  },
  "resumeFromCheckpoint": true,
  "debugSetup": {
   "flags": {
    "station_power": "backup",
    "sec_done": true,
    "medlab_open": true,
    "tunnel_started": true,
    "valve_done": true,
    "giles.infectionStage": 3,
    "giles.bandaged": true
   }
  },
  "steps": [
   {
    "do": "squadRegroup"
   },
   {
    "do": "setFlag",
    "flag": "climax_started",
    "value": true
   },
   {
    "do": "setFlag",
    "flag": "giles.infectionStage",
    "value": 3
   },
   {
    "do": "doorState",
    "id": "D_R10_R11",
    "state": "open"
   },
   {
    "do": "doorState",
    "id": "D_R13d_R11",
    "state": "open"
   },
   {
    "do": "doorState",
    "id": "D_R13b_R13d",
    "state": "sealed"
   },
   {
    "do": "lightState",
    "room": "R11",
    "pattern": "flicker",
    "tint": "emergency"
   },
   {
    "do": "npcMoveTo",
    "npc": "giles",
    "to": "anchor:r11_giles_task"
   },
   {
    "do": "npcMoveTo",
    "npc": "okafor",
    "to": "anchor:r11_okafor_end"
   },
   {
    "do": "say",
    "line": "climax_giles_01"
   },
   {
    "do": "spawnGroup",
    "group": "r11_climax"
   },
   {
    "parallel": [
     {
      "do": "npcTask",
      "npc": "giles",
      "task": "power_restore",
      "args": {
       "at": "anchor:r11_giles_task",
       "panel": "r11_power",
       "duration": 30
      },
      "wait": true
     },
     {
      "do": "loop",
      "count": 1,
      "steps": [
       {
        "do": "say",
        "line": "climax_okafor_01"
       },
       {
        "do": "waitFor",
        "event": "squad:taskProgress",
        "match": {
         "task": "power_restore"
        },
        "min": {
         "progress": 0.5
        },
        "timeout": 120
       },
       {
        "do": "say",
        "line": "climax_giles_02",
        "wait": false
       }
      ]
     },
     {
      "do": "waitGroup",
      "group": "r11_climax"
     }
    ]
   },
   {
    "do": "wait",
    "s": 0.8
   },
   {
    "do": "gatherIn",
    "room": "R11"
   },
   {
    "do": "say",
    "line": "climax_giles_03",
    "wait": false
   },
   {
    "do": "doorState",
    "id": "D_R10_R11",
    "state": "sealed"
   },
   {
    "do": "doorState",
    "id": "D_R13d_R11",
    "state": "sealed"
   },
   {
    "do": "sfx",
    "id": "hullGroan",
    "at": "anchor:r11_hold"
   },
   {
    "do": "cameraShake",
    "amount": 0.3,
    "s": 1
   },
   {
    "do": "lightState",
    "room": "R11",
    "pattern": "dying",
    "tint": "emergency"
   },
   {
    "do": "wait",
    "s": 2.5
   },
   {
    "do": "setFlag",
    "flag": "climax_done",
    "value": true
   },
   {
    "do": "completeObjective",
    "id": "obj_power"
   },
   {
    "do": "checkpoint",
    "id": "cp_climax_won",
    "label": "Auxiliary Power"
   },
   {
    "do": "emit",
    "event": "climax:won"
   }
  ]
 },
 {
  "id": "reveal_restore",
  "trigger": {
   "event": "game:mode",
   "match": {
    "mode": "playing",
    "from": "title"
   },
   "requires": "climax_done",
   "unless": "reveal_done"
  },
  "steps": [
   {
    "do": "if",
    "flag": "running:cliffhanger",
    "then": [],
    "else": [
     {
      "do": "if",
      "flag": "running:title_card",
      "then": [],
      "else": [
       {
        "do": "if",
        "flag": "running:stinger_priya",
        "then": [],
        "else": [
         {
          "do": "setFlag",
          "flag": "seq:cliffhanger",
          "value": false
         },
         {
          "do": "setFlag",
          "flag": "seq:title_card",
          "value": false
         },
         {
          "do": "setFlag",
          "flag": "seq:stinger_priya",
          "value": false
         },
         {
          "do": "setFlag",
          "flag": "giles.infectionStage",
          "value": 3
         },
         {
          "do": "setFlag",
          "flag": "giles.bandaged",
          "value": true
         },
         {
          "do": "lightState",
          "room": "R11",
          "pattern": "dying",
          "tint": "emergency"
         },
         {
          "do": "npcMoveTo",
          "npc": "giles",
          "to": "anchor:r11_giles_task",
          "instant": true
         },
         {
          "do": "npcMoveTo",
          "npc": "okafor",
          "to": "anchor:r11_okafor_end",
          "instant": true
         },
         {
          "do": "emit",
          "event": "climax:won"
         }
        ]
       }
      ]
     }
    ]
   }
  ]
 },
 {
  "id": "climax_hero",
  "trigger": {
   "event": "enemy:spawned",
