 {
  "id": "title_card",
  "trigger": {
   "event": "story:cliffhanger"
  },
  "once": true,
  "exclusive": "rails",
  "steps": [
   {
    "do": "wait",
    "s": 1
   },
   {
    "do": "titleCard",
    "title": "THALASSA",
    "sub": "SLICE ONE",
    "s": 5,
    "wait": true
   },
   {
    "do": "wait",
    "s": 1.4
   },
   {
    "do": "emit",
    "event": "story:title_done"
   }
  ]
 },
 {
  "id": "stinger_priya",
  "trigger": {
   "event": "story:title_done"
  },
  "once": true,
  "skippable": true,
  "exclusive": "rails",
  "steps": [
   {
    "do": "playerControl",
    "move": "locked",
    "look": "locked",
    "weapons": false,
    "interact": false
   },
   {
    "do": "hush",
    "speakers": [
     "nurse"
    ],
    "s": 0.6
   },
   {
    "do": "npcMoveTo",
    "npc": "priya",
    "to": "anchor:priya_rest",
    "instant": true
   },
   {
    "do": "npcAnim",
    "npc": "priya",
    "anim": "corpseProne",
    "instant": true
   },
   {
    "do": "cameraFeed",
    "id": "stinger",
    "from": "anchor:cam04_pos",
    "lookAt": "anchor:cam04_stinger_look",
    "state": "live",
    "fullscreen": true,
    "label": "CAM 04  MEDBAY",
    "fov": 70,
    "fps": 30,
    "size": {
     "w": 960,
     "h": 540
    },
    "look": "fullscreen"
   },
   {
    "do": "fade",
    "to": 0,
    "s": 0.6
   },
   {
    "parallel": [
     {
      "do": "kill",
      "npc": "priya",
      "kind": "convertedRise",
      "marks": {
       "camera": "anchor:cam04_pos"
      },
      "wait": true
     },
     {
      "do": "loop",
      "count": 1,
      "steps": [
       {
        "do": "waitFor",
        "event": "kill:face",
        "timeout": 20
       },
       {
        "do": "wait",
        "s": 1.2
       },
       {
        "do": "cameraFeed",
        "id": "stinger",
        "state": "static",
        "fullscreen": true
       }
      ]
     }
    ]
   },
   {
    "do": "wait",
    "s": 1.8
   },
   {
    "do": "fade",
    "to": 1,
    "s": 0.8,
    "wait": true
   },
   {
    "do": "cameraFeed",
    "id": "stinger",
    "state": "off",
    "fullscreen": true
   },
   {
    "do": "setFlag",
    "flag": "reveal_done",
    "value": true
   },
   {
    "do": "endSlice"
   }
  ]
 },
