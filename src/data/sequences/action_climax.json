   {
    "do": "say",
    "line": "end_giles_03"
   },
   {
    "do": "say",
    "line": "end_giles_04"
   },
   {
    "do": "say",
    "line": "end_giles_05"
   },
   {
    "do": "say",
    "line": "end_jay_02"
   },
   {
    "parallel": [
     {
      "do": "transform",
      "npc": "giles",
      "to": 1,
      "duration": 9
     },
     {
      "do": "loop",
      "count": 1,
      "steps": [
       {
        "do": "npcMoveTo",
        "npc": "okafor",
        "to": "anchor:r11_okafor_step",
        "speed": 1.4
       },
       {
        "do": "say",
        "line": "end_okafor_02"
       }
      ]
     },
     {
      "do": "loop",
      "count": 1,
      "steps": [
       {
        "do": "wait",
        "s": 1.2
       },
       {
        "do": "say",
        "line": "end_giles_06"
       }
      ]
     }
    ]
   },
   {
    "do": "wait",
    "s": 1
   },
   {
    "do": "npcFollow",
    "npc": "okafor",
    "stop": true
   },
   {
    "do": "fade",
    "to": 1,
    "s": 2.5,
    "wait": true
   },
   {
    "do": "emit",
    "event": "story:cliffhanger"
   }
  ]
