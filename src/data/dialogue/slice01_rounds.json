    { "id": "walkby_jay_02", "speaker": "player", "text": "...Rough night, I guess.",
      "emote": "question", "channel": "local", "priority": "story", "audio": "assets/vo/walkby_jay_02.mp3", "minDuration": 2.2, "choices": [] },
    { "id": "hydro_store_jay_02", "speaker": "player", "text": "Radio's still warm. They only just left.",
