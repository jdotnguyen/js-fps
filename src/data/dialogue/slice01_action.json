{
  "chapter": "slice01_action",
  "lines": [
    { "id": "cover_okafor_run_01", "speaker": "medic", "text": "Hey- hey! It's us! It's us!",
      "emote": "urgent", "direction": "shouting after someone running away in the dark, trying to stop her bolting", "channel": "local", "priority": "story", "audio": "assets/vo/cover_okafor_run_01.mp3", "minDuration": 2.6, "choices": [] },
    { "id": "cover_priya_run_01", "speaker": "nurse", "text": "[a sob as she stumbles]",
      "emote": "pained", "channel": "local", "priority": "story", "audio": ["assets/vo/react_priya_sob_01.mp3","assets/vo/react_priya_sob_02.mp3"], "minDuration": 2.3, "choices": [] },
    { "id": "sec_priya_10", "speaker": "nurse", "text": "Tomas? ...Tomas.",
      "emote": "alarmed", "direction": "a sharp frightened gasp first, then recognition and relief breaking through; the second \"Tomas\" is almost a sob", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_10.mp3", "minDuration": 1.3, "choices": [] },
    { "id": "sec_okafor_10", "speaker": "medic", "text": "It's me. Come to the door.",
      "emote": "neutral", "direction": "raised to carry through thick glass; steady, practised calm with tension underneath", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_10.mp3", "minDuration": 2.6, "choices": [] },
    { "id": "sec_priya_11", "speaker": "nurse", "text": "I'm sorry- I saw the guns, I thought you were-",
      "emote": "alarmed", "direction": "breathless and apologetic, words tumbling out, cutting herself off", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_11.mp3", "minDuration": 4, "choices": [] },
    { "id": "sec_okafor_11", "speaker": "medic", "text": "I know.",
      "emote": "neutral", "direction": "gentle but firm, raised to carry through glass", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_11.mp3", "minDuration": 1.3, "choices": [] },
    { "id": "sec_priya_12", "speaker": "nurse", "text": "It locked. When I shut it, it just- locked.",
      "emote": "alarmed", "direction": "disbelief rising into panic, pushing at a door that will not move", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_12.mp3", "minDuration": 3.7, "choices": [] },
    { "id": "sec_giles_10", "speaker": "engineer", "text": "Hang on. ...Admin's sealed the medical deck. Remotely. I can't touch it from here.",
      "emote": "dread", "direction": "first two words busy at a keyboard, then reading a screen and the realisation landing; quiet anger, no humour at all", "channel": "local", "priority": "story", "audio": "assets/vo/sec_giles_10.mp3", "minDuration": 5.4, "choices": [] },
    { "id": "sec_giles_11", "speaker": "engineer", "text": "I can give you the intercom.",
      "emote": "neutral", "direction": "offering the only thing he has, apologetic, subdued", "channel": "local", "priority": "story", "audio": "assets/vo/sec_giles_11.mp3", "minDuration": 2.6, "choices": [] },
    { "id": "sec_priya_13", "speaker": "nurse", "text": "...Tomas? Can you hear me?",
      "emote": "question", "direction": "small and shaky, close to a microphone", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_13.mp3", "minDuration": 2.3, "choices": [] },
    { "id": "sec_okafor_12", "speaker": "medic", "text": "We hear you.",
      "emote": "neutral", "direction": "steady and reassuring, tension under it", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_12.mp3", "minDuration": 1.6, "choices": [] },
    { "id": "sec_okafor_13", "speaker": "medic", "text": "Show me your hands. ...Turn around.",
      "emote": "neutral", "direction": "a doctor triaging: calm clinical orders, a short beat between the two", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_13.mp3", "minDuration": 2.6, "choices": [] },
    { "id": "sec_okafor_14", "speaker": "medic", "text": "Anything scratch you? Bite you?",
      "emote": "neutral", "direction": "clinical and careful, dread just under the calm", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_14.mp3", "minDuration": 2.3, "choices": [] },
    { "id": "sec_priya_14", "speaker": "nurse", "text": "No. I hid. I just hid.",
      "emote": "neutral", "direction": "shaky and tearful, trying to be brave for him", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_14.mp3", "minDuration": 2.6, "choices": [] },
    { "id": "sec_okafor_15", "speaker": "medic", "text": "Good. You're fine. ...You're fine.",
      "emote": "relieved", "direction": "the first said to her, reassuring; the second quieter, said to himself", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_15.mp3", "minDuration": 2.3, "choices": [] },
    { "id": "sec_priya_15", "speaker": "nurse", "text": "It's in the surgery. It's been in there since the lights went.",
      "emote": "whisper", "direction": "a frightened whisper, as if something in the next room could hear", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_15.mp3", "minDuration": 4.7, "choices": [] },
    { "id": "sec_priya_16", "speaker": "nurse", "text": "It's been... moving things.",
      "emote": "whisper", "direction": "barely audible, terrified", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_16.mp3", "minDuration": 2, "choices": [] },
    { "id": "sec_priya_17", "speaker": "nurse", "text": "[fast, panicked breathing, a whimper]",
      "emote": "pained", "channel": "local", "priority": "story", "audio": ["assets/vo/react_priya_breath_01.mp3","assets/vo/react_priya_breath_02.mp3"], "minDuration": 2.3, "choices": [] },
    { "id": "sec_okafor_16", "speaker": "medic", "text": "Look at me. Not the door. Me.",
      "emote": "neutral", "direction": "low and tense, holding himself together, firm and slow", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_16.mp3", "minDuration": 3, "choices": [] },
    { "id": "sec_okafor_17", "speaker": "medic", "text": "Back to the wall. By the beds. Sit. ...That's medical advice.",
      "emote": "neutral", "direction": "tense calm orders; after a pause the last sentence is gentle, close to breaking", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_17.mp3", "minDuration": 4.3, "choices": [] },
    { "id": "sec_priya_18", "speaker": "nurse", "text": "That's my line.",
      "emote": "laugh", "direction": "a nervous, shaking laugh through tears that falls apart into a sob before the line ends; not amused", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_18.mp3", "minDuration": 1.6, "choices": [] },
    { "id": "sec_giles_12", "speaker": "engineer", "text": "Armory's on its own circuit. That one I can open.",
      "emote": "neutral", "direction": "flat and focused, no humour", "channel": "local", "priority": "story", "audio": "assets/vo/sec_giles_12.mp3", "minDuration": 4, "choices": [] },
    { "id": "sec_giles_13", "speaker": "engineer", "text": "Jay. Take it.",
      "emote": "neutral", "direction": "quiet and grim", "channel": "local", "priority": "story", "audio": "assets/vo/sec_giles_13.mp3", "minDuration": 1.6, "choices": [] },
    { "id": "sec_priya_19", "speaker": "nurse", "text": "I made you a coffee. Before. It's still on the counter.",
      "emote": "neutral", "direction": "small and wistful, holding herself together", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_19.mp3", "minDuration": 4.3, "choices": [] },
    { "id": "sec_okafor_18", "speaker": "medic", "text": "I'll drink it.",
      "emote": "neutral", "direction": "soft and steady", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_18.mp3", "minDuration": 1.6, "choices": [] },
    { "id": "sec_priya_20", "speaker": "nurse", "text": "It'll be cold.",
      "emote": "neutral", "direction": "almost a laugh, tearful", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_20.mp3", "minDuration": 1.6, "choices": [] },
    { "id": "sec_okafor_19", "speaker": "medic", "text": "I'll drink it cold.",
      "emote": "neutral", "direction": "soft, warm and firm, a promise", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_19.mp3", "minDuration": 2, "choices": [] },
    { "id": "sec_okafor_22", "speaker": "medic", "text": "I'm here. ...I'm here.",
      "emote": "whisper", "direction": "barely audible, to her through the glass with his hand on it; his voice catches on the second one; not for anyone else", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_22.mp3", "minDuration": 2.4, "choices": [] },
    { "id": "sec_okafor_20", "speaker": "medic", "text": "I told her she was fine.",
      "emote": "dread", "direction": "flat, quiet and hollow", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_20.mp3", "minDuration": 2.6, "choices": [] },
    { "id": "sec_okafor_21", "speaker": "medic", "text": "Med lab's through there.",
      "emote": "dread", "direction": "quiet, after a long silence; purely functional", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_21.mp3", "minDuration": 2, "choices": [] },
    { "id": "sec_okafor_08", "speaker": "medic", "text": "The door. Jay, the door!",
      "emote": "urgent", "channel": "local", "priority": "story", "audio": "assets/vo/sec_okafor_08.mp3", "minDuration": 1.6, "choices": [] },
    { "id": "sec_giles_06", "speaker": "engineer", "text": "I can't- Tomas, I can't override it!",
      "emote": "alarmed", "channel": "local", "priority": "story", "audio": "assets/vo/sec_giles_06.mp3", "minDuration": 2.8, "choices": [] },
    { "id": "sec_giles_07", "speaker": "engineer", "text": "Christ. Oh, Christ.",
      "emote": "dread", "channel": "local", "priority": "story", "audio": "assets/vo/sec_giles_07.mp3", "minDuration": 2.0, "choices": [] },
    { "id": "sec_jay_01", "speaker": "player", "text": "Hey! HEY! Get off her!",
      "emote": "scream", "channel": "local", "priority": "story", "audio": "assets/vo/sec_jay_01.mp3", "minDuration": 1.6, "choices": [] },
    { "id": "sec_jay_02", "speaker": "player", "text": "...no.",
      "emote": "whisper", "channel": "local", "priority": "story", "audio": "assets/vo/sec_jay_02.mp3", "minDuration": 1.2, "choices": [] },
    { "id": "sec_priya_05", "speaker": "nurse", "text": "Open it, open it, please-",
      "emote": "scream", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_05.mp3", "minDuration": 1.8, "choices": [] },
    { "id": "sec_priya_06", "speaker": "nurse", "text": "[full scream]",
      "emote": "scream", "channel": "local", "priority": "story", "audio": ["assets/vo/react_priya_scream_01.mp3","assets/vo/react_priya_scream_02.mp3","assets/vo/react_priya_scream_03.mp3"], "minDuration": 1.6, "choices": [] },
    { "id": "sec_priya_07", "speaker": "nurse", "text": "[cut-off cry]",
      "emote": "pained", "channel": "local", "priority": "story", "audio": ["assets/vo/react_priya_cutoff_01.mp3","assets/vo/react_priya_cutoff_02.mp3","assets/vo/react_priya_cutoff_03.mp3"], "minDuration": 0.8, "choices": [] },
    { "id": "stinger_priya_06", "speaker": "nurse", "text": "[a wet, rattling breath]",
      "emote": "pained", "channel": "local", "priority": "story", "audio": ["assets/vo/react_priya_choke_02.mp3"], "minDuration": 1.4, "choices": [] },
    { "id": "sec_jay_bang_01", "speaker": "player", "text": "Behind you!",
      "emote": "urgent", "channel": "local", "priority": "story", "audio": "assets/vo/sec_jay_bang_01.mp3", "minDuration": 1.0, "choices": [] },
    { "id": "sec_jay_bang_02", "speaker": "player", "text": "HEY! HERE!",
      "emote": "urgent", "channel": "local", "priority": "story", "audio": "assets/vo/sec_jay_bang_02.mp3", "minDuration": 1.0, "choices": [] },
    { "id": "sec_jay_bang_03", "speaker": "player", "text": "Turn around- turn around!",
      "emote": "urgent", "channel": "local", "priority": "story", "audio": "assets/vo/sec_jay_bang_03.mp3", "minDuration": 1.0, "choices": [] },
    { "id": "sec_jay_bang_04", "speaker": "player", "text": "Over here, you-!",
      "emote": "urgent", "channel": "local", "priority": "story", "audio": "assets/vo/sec_jay_bang_04.mp3", "minDuration": 1.0, "choices": [] },
    { "id": "contact_okafor_03", "speaker": "medic", "text": "Legs! Take its legs!",
      "emote": "urgent", "channel": "local", "priority": "story", "audio": "assets/vo/contact_okafor_03.mp3", "minDuration": 1.6, "choices": [] },
    { "id": "sec_priya_03", "speaker": "nurse", "text": "[choking]",
      "emote": "pained", "channel": "local", "priority": "story", "audio": ["assets/vo/react_priya_choke_01.mp3","assets/vo/react_priya_choke_02.mp3"], "minDuration": 1.2, "choices": [] },
    { "id": "sec_priya_04", "speaker": "nurse", "text": "Tomas, please- please-",
      "emote": "scream", "channel": "local", "priority": "story", "audio": "assets/vo/sec_priya_04.mp3", "minDuration": 1.8, "choices": [] },
    { "id": "climax_okafor_02", "speaker": "medic", "text": "Big one. Shotgun, Jay. Now.",
      "emote": "urgent", "channel": "local", "priority": "story", "audio": "assets/vo/climax_okafor_02.mp3", "minDuration": 1.8, "choices": [] }
  ]
}
